# Optional: cookie string of a logged-in YouTube session (helps against
# "Sign in to confirm you're not a bot" on datacenter IPs such as Vercel).
YT_COOKIE=

# Optional: comma-separated InnerTube clients tried in order when resolving audio.
# YT_CLIENTS=ANDROID_VR,IOS,TV,WEB_EMBEDDED,MWEB

# Optional: base URL of an external stream backend. Empty = local Next.js API routes.
NEXT_PUBLIC_STREAM_API_URL=
