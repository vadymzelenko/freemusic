# Скопируйте в .env.local (локально) или вставьте в Vercel → Settings → Environment Variables.
# ВСЕ переменные необязательные — без них приложение работает, данные хранятся только в браузере.

# ── Supabase: вход через Google + синхронизация лайков/плейлистов между устройствами ──
# Supabase → Project Settings → API → "Project URL" и "anon / publishable key"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── YouTube ──
# Прокси с домашним (residential/ISP) IP для всех запросов к YouTube — тогда cookie не нужна.
# Формат: http://user:pass@host:port
YT_PROXY_URL=

# Cookie вашего аккаунта YouTube. Нужна ТОЛЬКО если на Vercel поиск/воспроизведение
# падают с ошибкой "Sign in to confirm you're not a bot". Как получить — см. README.
YT_COOKIE=

# Порядок "клиентов" YouTube, через которые сервер пробует получить аудио. Не трогайте без нужды.
# YT_CLIENTS=ANDROID_VR,IOS,TV,WEB_EMBEDDED,MWEB

# ── Внешний бэкенд (продвинутое) ──
# Пусто = API работает внутри этого же Next.js на Vercel (так и нужно в 99% случаев).
# Если когда-нибудь вынесете /api/* на отдельный сервер (VPS с "домашним" IP), впишите его адрес,
# например https://music-api.example.com
NEXT_PUBLIC_STREAM_API_URL=
