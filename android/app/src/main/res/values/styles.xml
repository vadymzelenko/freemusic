<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark app theme: no white areas behind the system bars or while the page loads. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/vz_background</item>
        <item name="android:statusBarColor">@color/vz_background</item>
        <item name="android:navigationBarColor">@color/vz_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/vz_background</item>
        <item name="android:windowBackground">@color/vz_background</item>
        <item name="android:statusBarColor">@color/vz_background</item>
        <item name="android:navigationBarColor">@color/vz_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/vz_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
